{
  "name": "ricochet-rivals",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "description": "横版 2D 回合制弹道对战网页游戏 (Side-scrolling turn-based artillery PvP web game)",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && node scripts/asset-optimization.mjs && vite build && node scripts/validate-built-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:octopus": "node scripts/e2e-octopus.mjs",
    "e2e:octopus-online": "node scripts/e2e-octopus-online.mjs",
    "e2e:settings": "node scripts/e2e-settings.mjs",
    "e2e:loading": "node scripts/e2e-loading.mjs",
    "e2e:items": "node scripts/e2e-items.mjs",
    "e2e:settings-online": "node scripts/e2e-settings-online.mjs",
    "assets:optimize": "node scripts/asset-optimization.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
